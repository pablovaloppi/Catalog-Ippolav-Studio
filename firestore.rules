rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) || 
        (request.auth.token.email != null && request.auth.token.email.lower() == 'pablovaloppi@gmail.com')
      );
    }

    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128; 
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidFigure(data) {
      return data.title is string && data.title.size() <= 300
        && data.franchiseId is string && data.franchiseId.size() <= 100
        && data.get('designerId', '') is string && data.get('designerId', '').size() <= 100
        && data.get('numericId', '') is string && data.get('numericId', '').size() <= 100
        && data.get('likesCount', 0) is int && data.get('likesCount', 0) >= 0
        && data.status is string && data.status.matches('^(disponible|consultar|proximamente)$');
    }

    function isValidCategory(data) {
      return data.name is string && data.name.size() <= 100
        && data.get('icon', 'star') is string && data.get('icon', 'star').size() <= 100
        && data.get('parentId', '') is string && data.get('parentId', '').size() <= 100;
    }

    function isValidDesigner(data) {
      return data.name is string && data.name.size() <= 200;
    }

    match /admins/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
    }

    match /figures/{figureId} {
      allow read: if true;
      allow create: if isAdmin() 
        && isValidId(figureId) 
        && isValidFigure(incoming());
      allow update: if (
        (isAdmin() && isValidId(figureId) && isValidFigure(incoming())) ||
        (
          isValidId(figureId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['likesCount']) &&
          incoming().likesCount is int &&
          incoming().likesCount >= 0
        )
      );
      allow delete: if isAdmin() && isValidId(figureId);
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAdmin() 
        && isValidId(categoryId)
        && isValidCategory(incoming());
      allow update: if isAdmin() 
        && isValidId(categoryId)
        && isValidCategory(incoming());
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    match /designers/{designerId} {
      allow read: if true;
      allow create: if isAdmin() 
        && isValidId(designerId)
        && isValidDesigner(incoming());
      allow update: if isAdmin() 
        && isValidId(designerId)
        && isValidDesigner(incoming());
      allow delete: if isAdmin() && isValidId(designerId);
    }

    match /config/{configId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(configId);
    }

    match /analytics_daily/{dateId} {
      allow read: if isAdmin();
      allow create, update: if isValidId(dateId);
      allow delete: if isAdmin();
    }

    match /analytics_events/{eventId} {
      allow read: if isAdmin();
      allow create: if isValidId(eventId) && incoming().type is string;
      allow update, delete: if isAdmin();
    }
  }
}
