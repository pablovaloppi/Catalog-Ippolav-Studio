{
  "entities": {
    "admin": {
      "title": "Admin",
      "description": "Administrator of the IPPOLAV STUDIO",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Email address of the admin"
        }
      },
      "required": ["email"]
    },
    "figure": {
      "title": "Figure",
      "description": "A collectible sculpture or figure",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 300 },
        "numericId": { "type": "string", "maxLength": 100 },
        "franchiseId": { "type": "string", "maxLength": 100 },
        "designerId": { "type": "string", "maxLength": 100 },
        "status": {
          "type": "string",
          "enum": ["disponible", "consultar", "proximamente"]
        },
        "imageUrls": {
          "type": "array",
          "description": "List of image URLs. The first one is the cover.",
          "maxLength": 20,
          "items": { "type": "string" }
        },
        "finish": { "type": "string", "maxLength": 100 },
        "scale": {
          "type": "array",
          "items": { "type": "string", "maxLength": 50 },
          "maxLength": 20
        },
        "material": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 10000 },
        "badge": { "type": "string", "maxLength": 200 },
        "whatsappMessage": { "type": "string", "maxLength": 5000 },
        "order": { "type": "number" },
        "likesCount": { "type": "number", "description": "Number of likes/hearts from visitors" },
        "selectedInRandomDraw": { "type": "boolean", "description": "Flag indicating if the figure was selected in the random picker" },
        "selectedInRandomDrawAt": { "type": "timestamp", "description": "Timestamp when the figure was drawn in random picker" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": [
        "title",
        "franchiseId",
        "status"
      ]
    },
    "category": {
      "title": "Category",
      "description": "A franchise or category of figures",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 50 },
        "icon": { "type": "string", "maxLength": 50 },
        "parentId": { "type": "string", "maxLength": 50 },
        "order": { "type": "number" }
      },
      "required": ["name", "icon"]
    },
    "designer": {
      "title": "Designer",
      "description": "A designer or artist",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "order": { "type": "number" }
      },
      "required": ["name"]
    },
    "config": {
      "title": "SiteConfig",
      "description": "General settings for the site",
      "type": "object",
      "properties": {
        "whatsapp": { "type": "string" },
        "whatsappMessageTemplate": { "type": "string" },
        "instagram": { "type": "string" },
        "facebook": { "type": "string" },
        "youtube": { "type": "string" }
      }
    },
    "analyticsDaily": {
      "title": "AnalyticsDaily",
      "description": "Aggregated daily site telemetry and metrics",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "viewsTotal": { "type": "number" },
        "viewsFromInstagram": { "type": "number" },
        "viewsFromWhatsApp": { "type": "number" },
        "viewsFromDirect": { "type": "number" },
        "viewsFromOther": { "type": "number" },
        "deviceMobile": { "type": "number" },
        "deviceDesktop": { "type": "number" },
        "whatsappTotalClicks": { "type": "number" },
        "updatedAt": { "type": "timestamp" }
      }
    },
    "analyticsEvent": {
      "title": "AnalyticsEvent",
      "description": "Anonymous live interaction event log",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "source": { "type": "string" },
        "figureId": { "type": "string" },
        "figureTitle": { "type": "string" },
        "searchTerm": { "type": "string" },
        "device": { "type": "string" },
        "timestamp": { "type": "timestamp" }
      },
      "required": ["type", "timestamp"]
    }
  },
  "firestore": {
    "admins/{userId}": {
      "schema": "admin",
      "description": "Stores admin users."
    },
    "figures/{figureId}": {
      "schema": "figure",
      "description": "Stores the collectible figures."
    },
    "categories/{categoryId}": {
      "schema": "category",
      "description": "Stores the franchises/categories."
    },
    "designers/{designerId}": {
      "schema": "designer",
      "description": "Stores the designers/artists."
    },
    "config/{configId}": {
      "schema": "config",
      "description": "Stores the store configuration."
    },
    "analytics_daily/{dateId}": {
      "schema": "analyticsDaily",
      "description": "Stores aggregated daily analytics."
    },
    "analytics_events/{eventId}": {
      "schema": "analyticsEvent",
      "description": "Stores recent visitor interaction events."
    }
  }
}
